{
  "name": "algions-pharmacy",
  "version": "1.0.0",
  "private": true,
  "description": "ALGIONS Pharmacy - Cloud-First Pharmacy ERP with Primary Offline Workstation",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "build": "pnpm -r --sort run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "seed": "pnpm --filter @algions/db run seed",
    "start:api": "pnpm --filter @algions/api run start",
    "dev:api": "pnpm --filter @algions/api run dev",
    "dev:pos": "pnpm --filter @algions/pos-desktop run dev",
    "dev:owner": "pnpm --filter @algions/owner-web run dev"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.8.2"
  }
}
